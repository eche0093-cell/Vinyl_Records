{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Artists most often seen in a sample of Australian vinyl",
    "subtitle": "Sample of releases from 1975 to 2025, not a sales ranking. Only artists seen at least twice appear."
  },
  "width": 400,
  "height": 260,
  "params": [
    {
      "name": "decade_pick",
      "value": "All",
      "bind": {
        "input": "select",
        "options": [
          "All",
          "1970s",
          "1980s",
          "1990s",
          "2000s",
          "2010s",
          "2020s"
        ],
        "name": "Decade: "
      }
    }
  ],
  "data": {
    "url": "https://raw.githubusercontent.com/eche0093-cell/Vinyl_Records/main/data/releases.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "filter": "isValid(datum.artist) && datum.artist !== '' && datum.artist !== 'Unknown Artist' && datum.artist !== 'Various'"
    },
    {
      "filter": "decade_pick === 'All' || datum.decade === decade_pick"
    },
    {
      "calculate": "replace(datum.artist, '*', '')",
      "as": "artist_clean"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "releases"
        }
      ],
      "groupby": [
        "artist_clean"
      ]
    },
    {
      "filter": "datum.releases >= 2"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "releases",
          "order": "descending"
        },
        {
          "field": "artist_clean",
          "order": "ascending"
        }
      ]
    },
    {
      "filter": "datum.rank <= 8"
    }
  ],
  "encoding": {
    "y": {
      "field": "artist_clean",
      "type": "nominal",
      "sort": "-x",
      "title": null
    },
    "x": {
      "field": "releases",
      "type": "quantitative",
      "title": "Releases in sample",
      "axis": {
        "tickMinStep": 1,
        "format": "d"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#999"
      },
      "encoding": {
        "x2": {
          "datum": 0
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 120,
        "color": "#1f618d",
        "tooltip": true
      }
    }
  ]
}
