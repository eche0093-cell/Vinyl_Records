{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Record labels most often seen in a sample of Australian vinyl",
    "subtitle": "Sample of releases from 1975, 1980, 1990, 2000, 2010, 2020 and 2025, not a sales ranking"
  },
  "width": 400,
  "height": 300,
  "params": [
    {
      "name": "decade_pick",
      "value": "All",
      "bind": {"input": "select", "options": ["All", "1970s", "1980s", "1990s", "2000s", "2010s", "2020s"], "name": "Decade: "}
    }
  ],
  "data": {
    "url": "https://raw.githubusercontent.com/eche0093-cell/Vinyl_Records/main/data/releases.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {"filter": "isValid(datum.label) && datum.label !== '' && datum.label !== 'Not On Label'"},
    {"filter": "decade_pick === 'All' || datum.decade === decade_pick"},
    {"aggregate": [{"op": "count", "as": "releases"}], "groupby": ["label"]},
    {"window": [{"op": "rank", "as": "rank"}], "sort": [{"field": "releases", "order": "descending"}]},
    {"filter": "datum.rank <= 12"}
  ],
  "encoding": {
    "y": {"field": "label", "type": "nominal", "sort": "-x", "title": null},
    "x": {"field": "releases", "type": "quantitative", "title": "Releases in sample"}
  },
  "layer": [
    {"mark": {"type": "rule", "color": "#999"}, "encoding": {"x2": {"datum": 0}}},
    {"mark": {"type": "point", "filled": true, "size": 120, "color": "#b03a2e", "tooltip": true}}
  ]
}
