        "dy": -26,
        "fontWeight": "bold",
        "fontSize": 12
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "scale": {
            "domain": [
              2011,
              2012,
              2013,
              2014,
              2015,
              2016,
              2017,
              2018,
              2019,
              2020,
              2021,
              2022,
              2023
            ]
          },
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "units",
          "type": "quantitative",
          "title": "Albums sold",
          "scale": {
            "domain": [
              0,
              1400000
            ]
          }
        },
        "text": {
          "value": "Passes 1 million, 2020"
        }
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/eche0093-cell/Vinyl_Records/main/data/aria_physical_sales.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "units": "number",
            "revenue_aud": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.format === 'Vinyl Albums'"
        },
        {
          "filter": "datum.year === 2023"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": 16,
        "dy": -26,
        "fontWeight": "bold",
        "fontSize": 12
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "scale": {
            "domain": [
              2011,
              2012,
              2013,
              2014,
              2015,
              2016,
              2017,
              2018,
              2019,
              2020,
              2021,
              2022,
              2023
            ]
          },
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "units",
          "type": "quantitative",
          "title": "Albums sold",
          "scale": {
            "domain": [
              0,
