{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Which genres filled Australian vinyl racks, decade by decade",
    "subtitle": "Darker means more releases. The 2020s cover 2020-2025 only. One release can have several genres."
  },
  "width": 450,
  "height": 300,
  "data": {
    "url": "https://raw.githubusercontent.com/eche0093-cell/Vinyl_Records/main/data/counts.csv",
    "format": {"type": "csv"}
  },
  "transform": [{"filter": "datum.genre !== 'ALL'"}],
  "mark": {"type": "rect", "tooltip": true},
  "encoding": {
    "x": {"field": "decade", "type": "ordinal", "title": null, "axis": {"labelAngle": 0}},
    "y": {
      "field": "genre",
      "type": "nominal",
      "title": null,
      "sort": {"field": "count", "op": "sum", "order": "descending"}
    },
    "color": {
      "aggregate": "sum",
      "field": "count",
      "type": "quantitative",
      "title": "Releases",
      "scale": {"scheme": "oranges", "type": "sqrt"}
    }
  }
}
