{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Genre by genre: Australian vinyl releases per year",
    "subtitle": "Each small chart has its own vertical scale, so compare shapes, not heights"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/eche0093-cell/Vinyl_Records/main/data/counts.csv",
    "format": {"type": "csv"}
  },
  "transform": [{"filter": "datum.genre !== 'ALL'"}],
  "facet": {"field": "genre", "type": "nominal", "columns": 4, "title": null},
  "spec": {
    "width": 160,
    "height": 90,
    "mark": {"type": "area", "color": "#b03a2e", "opacity": 0.8},
    "encoding": {
      "x": {"field": "year", "type": "quantitative", "title": null, "axis": {"format": "d", "tickCount": 4}, "scale": {"zero": false}},
      "y": {"field": "count", "type": "quantitative", "title": null}
    }
  },
  "resolve": {"scale": {"y": "independent"}}
}
